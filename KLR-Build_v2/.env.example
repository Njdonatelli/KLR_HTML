# Copy to .env and fill in. Everything here is exposed to the browser —
# VITE_-prefixed variables are inlined into the bundle at build time, so never
# put a secret in this file.

# --- Required for the site to accept form submissions -----------------------
# n8n Production webhook URL that receives lead and review submissions.
# Both post {kind, submittedAt, sourceUrl, data} as JSON.
# kind is "lead" or "review"; branch on it inside the workflow.
# Without this, both forms show an error telling visitors to call instead.
VITE_LEAD_WEBHOOK_URL=

# --- Optional ---------------------------------------------------------------
# GA4 measurement ID. Analytics is inert (no script, no events) when unset.
VITE_GA4_MEASUREMENT_ID=

# --- Supabase (already provisioned) -----------------------------------------
# Used by the MCP edge function and the Lovable auth pages.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
